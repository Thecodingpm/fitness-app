rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 👤 Per-User Data Ownership Model:
    // Only an authenticated user matching the document's userId may read or write.
    // Cross-user access is strictly forbidden.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections (workouts, completed_sets, exercise_data, calendar_data)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
